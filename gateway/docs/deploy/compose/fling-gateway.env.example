# Copy to fling-gateway.env (chmod 600, keep it out of git) and fill in.
# All settings: gateway/README.md, "Configuration".

FLING_PUBLIC_URL=https://fling.example.com

# Storage for the shared files. The key needs s3:ListBucket on the bucket and
# s3:PutObject, s3:GetObject, s3:DeleteObject on its objects.
FLING_S3_ENDPOINT=https://s3.example.com
FLING_S3_REGION=us-east-1
FLING_S3_BUCKET=fling-gateway
FLING_S3_ACCESS_KEY=
FLING_S3_SECRET_KEY=
FLING_S3_PATH_STYLE=true

# Sign-in: local accounts (passkeys, passwords). Add FLING_MICROSOFT_* / FLING_GOOGLE_* for those.
FLING_LOCAL_ACCOUNTS=true
FLING_ADMIN_EMAILS=you@example.com

# Invites and password resets by email (Resend). Leave empty to pass links on by hand.
FLING_RESEND_API_KEY=
FLING_MAIL_FROM=Fling <fling@example.com>

# Caddy's network (compose.yml), for per-IP sign-in throttling.
FLING_TRUSTED_PROXIES=172.30.0.0/24

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fling.SendWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fling">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid Padding="16,8,16,16" RowSpacing="{StaticResource FlingSpace2}" PointerEntered="Root_PointerEntered">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="{StaticResource FlingSpace1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource FlingLabelTextStyle}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Style="{StaticResource FlingQuietSmallButtonStyle}" Click="InfoButton_Click"
                    ToolTipService.ToolTip="Recent uploads" AutomationProperties.Name="Recent uploads">
                <FontIcon Glyph="&#xE946;" FontSize="14"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource FlingQuietSmallButtonStyle}" Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="{StaticResource FlingSpace2}"/>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="{StaticResource FlingSpace2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource FlingCaptionTextStyle}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="CopyButton" Grid.Column="1" Content="Copy link" Visibility="Collapsed"
                    Style="{StaticResource FlingSecondaryButtonStyle}" Click="CopyButton_Click"/>
            <Button Grid.Column="2" Content="Close"
                    Style="{StaticResource FlingQuietButtonStyle}" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>

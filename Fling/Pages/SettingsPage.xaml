<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fling.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fling">

    <Grid>
        <ScrollViewer>
            <Grid Padding="{StaticResource FlingWindowPadding}">
                <!-- Left-aligned, filling the width up to a readable maximum. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="640"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource FlingSpace6}">
                <TextBlock Text="Settings" Style="{StaticResource FlingTitleTextStyle}"/>

                <Border Style="{StaticResource FlingCardStyle}">
                    <StackPanel Spacing="{StaticResource FlingSpace4}">
                        <StackPanel Spacing="{StaticResource FlingSpace1}">
                            <TextBlock Text="Where files go" Style="{StaticResource FlingLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource FlingCaptionTextStyle}"
                                       Text="Use your own storage, or your organisation's Fling Gateway if it has one."/>
                        </StackPanel>
                        <RadioButtons x:Name="StorageChoice" SelectionChanged="StorageChoice_SelectionChanged">
                            <RadioButton Content="My own storage (S3-compatible)"/>
                            <RadioButton Content="My organisation's Fling Gateway"/>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border x:Name="GatewayCard" Style="{StaticResource FlingCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="{StaticResource FlingSpace4}">
                        <StackPanel Spacing="{StaticResource FlingSpace1}">
                            <TextBlock Text="Fling Gateway" Style="{StaticResource FlingLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource FlingCaptionTextStyle}"
                                       Text="You sign in once in your browser. The gateway keeps the storage keys and decides how long links last."/>
                        </StackPanel>
                        <TextBox x:Name="GatewayUrlTextBox" Header="Gateway address"
                                 PlaceholderText="https://fling.example.com" InputScope="Url"
                                 TextChanged="GatewayUrlTextBox_TextChanged"/>
                        <StackPanel Spacing="{StaticResource FlingSpace2}">
                            <TextBlock x:Name="GatewayAccountText" Style="{StaticResource FlingBodyTextStyle}"
                                       TextWrapping="Wrap" Text="Not signed in."/>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource FlingSpace2}">
                                <Button x:Name="GatewaySignInButton" Content="Sign in"
                                        Style="{StaticResource FlingSecondaryButtonStyle}" Click="GatewaySignIn_Click"/>
                                <Button x:Name="GatewayCancelButton" Content="Cancel" Visibility="Collapsed"
                                        Style="{StaticResource FlingQuietButtonStyle}" Click="GatewayCancel_Click"/>
                                <Button x:Name="GatewaySignOutButton" Content="Sign out" Visibility="Collapsed"
                                        Style="{StaticResource FlingQuietButtonStyle}" Click="GatewaySignOut_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="StorageCard" Style="{StaticResource FlingCardStyle}">
                    <StackPanel Spacing="{StaticResource FlingSpace4}">
                        <StackPanel Spacing="{StaticResource FlingSpace1}">
                            <TextBlock Text="Storage" Style="{StaticResource FlingLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource FlingCaptionTextStyle}"
                                       Text="Fling uploads to S3-compatible storage you own: MinIO, Backblaze B2, Cloudflare R2 or Amazon S3."/>
                        </StackPanel>

                        <TextBox x:Name="EndpointTextBox" Header="Endpoint"
                                 PlaceholderText="https://s3.eu-central-003.backblazeb2.com"/>
                        <TextBox x:Name="RegionTextBox" Header="Region"
                                 PlaceholderText="us-east-1 (Cloudflare R2: auto)"/>
                        <TextBox x:Name="BucketTextBox" Header="Bucket" PlaceholderText="my-bucket"/>
                        <TextBox x:Name="AccessKeyTextBox" Header="Access key ID"/>

                        <Grid ColumnSpacing="{StaticResource FlingSpace2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="SecretKeyPasswordBox" Header="Secret access key"
                                         PasswordRevealMode="Hidden"/>
                            <Button x:Name="RevealButton" Grid.Column="1" Content="Show"
                                    VerticalAlignment="Bottom" Style="{StaticResource FlingQuietButtonStyle}"
                                    Click="RevealButton_Click"/>
                            <Button Grid.Column="2" Content="Copy"
                                    VerticalAlignment="Bottom" Style="{StaticResource FlingQuietButtonStyle}"
                                    Click="CopySecretButton_Click"/>
                        </Grid>

                        <NumberBox x:Name="ExpiryNumberBox" Header="Links expire after (days)"
                                   Minimum="1" Maximum="7" SmallChange="1" LargeChange="1"
                                   SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="160"/>

                        <CheckBox x:Name="PathStyleCheckBox"
                                  Content="Use path-style addressing on Amazon S3 (other services always use it)"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource FlingCardStyle}">
                    <StackPanel Spacing="{StaticResource FlingSpace4}">
                        <StackPanel Spacing="{StaticResource FlingSpace1}">
                            <TextBlock Text="Sharing several items" Style="{StaticResource FlingLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource FlingCaptionTextStyle}"
                                       Text="Folders are always zipped. Choose what happens when you share more than one item at once."/>
                        </StackPanel>
                        <RadioButtons x:Name="MultipleChoice">
                            <RadioButton Content="One zip file with one link"/>
                            <RadioButton Content="A separate link for each file"/>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource FlingCardStyle}">
                    <StackPanel Spacing="{StaticResource FlingSpace4}">
                        <StackPanel Spacing="{StaticResource FlingSpace1}">
                            <TextBlock Text="Troubleshooting" Style="{StaticResource FlingLabelTextStyle}"/>
                            <TextBlock Style="{StaticResource FlingCaptionTextStyle}"
                                       Text="Fling keeps a small log on this PC. Nothing is sent anywhere. Add it when you report a problem; it never contains your keys, links or file names."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FlingSpace2}">
                            <Button Content="Open log folder" Style="{StaticResource FlingSecondaryButtonStyle}"
                                    Click="OpenLogFolder_Click"/>
                            <Button Content="Copy diagnostic info" Style="{StaticResource FlingQuietButtonStyle}"
                                    Click="CopyDiagnostics_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="{StaticResource FlingSpace4}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FlingSpace2}">
                        <Button x:Name="SaveButton" Content="Save"
                                Style="{StaticResource FlingPrimaryButtonStyle}" Click="SaveButton_Click"/>
                        <Button x:Name="TestButton" Content="Test connection"
                                Style="{StaticResource FlingSecondaryButtonStyle}" Click="TestButton_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Spacing="{StaticResource FlingSpace2}"
                                Visibility="Collapsed">
                        <FontIcon x:Name="StatusGlyph" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource FlingBodyTextStyle}"
                                   VerticalAlignment="Center" MaxWidth="560"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:FlingToast x:Name="Toast"/>
    </Grid>
</Page>

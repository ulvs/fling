<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fling.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fling"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="S3 Configuration" Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBox x:Name="EndpointTextBox"
                     Header="Endpoint URL"
                     PlaceholderText="https://ACCOUNT_ID.r2.cloudflarestorage.com, https://s3.amazonaws.com, ..."/>

            <TextBox x:Name="RegionTextBox"
                     Header="Region"
                     PlaceholderText="us-east-1 (Cloudflare R2: auto)"/>

            <TextBox x:Name="BucketTextBox"
                     Header="Bucket Name"
                     PlaceholderText="my-bucket"/>

            <TextBox x:Name="AccessKeyTextBox"
                     Header="Access Key ID"
                     PlaceholderText="AKIAIOSFODNN7EXAMPLE"/>

            <PasswordBox x:Name="SecretKeyPasswordBox"
                         Header="Secret Access Key"
                         PlaceholderText="Enter your secret key"/>

            <NumberBox x:Name="ExpiryNumberBox"
                       Header="Link Expiry (seconds)"
                       Value="604800"
                       Minimum="3600"
                       Maximum="604800"
                       SpinButtonPlacementMode="Inline"/>

            <CheckBox x:Name="PathStyleCheckBox"
                      Content="Use path-style addressing (required for MinIO)"/>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click"/>

                <Button x:Name="TestButton"
                        Content="Test Connection"
                        Click="TestButton_Click"/>
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>

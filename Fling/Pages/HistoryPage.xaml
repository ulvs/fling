<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fling.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fling"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
            <TextBlock Text="Upload History"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>

            <Button x:Name="ShareFileButton"
                    Content="Share a file..."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ShareFileButton_Click"/>

            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Click="RefreshButton_Click"/>

            <Button x:Name="ClearAllButton"
                    Content="Clear All"
                    Click="ClearAllButton_Click"/>
        </StackPanel>

        <ListView x:Name="HistoryListView"
                  Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{Binding FormattedDate}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding FormattedSize}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="{Binding StatusColor}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="Copy Link"
                                Tag="{Binding Url}"
                                Click="CopyLinkButton_Click"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasUrl}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyStateText"
                   Grid.Row="1"
                   Text="No uploads yet"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"/>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fling.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fling">

    <Grid>
        <ScrollViewer>
            <Grid Padding="{StaticResource FlingWindowPadding}">
                <!-- Left-aligned, filling the width up to a readable maximum. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource FlingSpace6}">
                <Image Source="{ThemeResource FlingLogoSource}" Height="32" HorizontalAlignment="Left"
                       AutomationProperties.Name="Fling"/>

                <local:DropZone x:Name="Drop"/>

                <StackPanel Spacing="{StaticResource FlingSpace2}">
                    <Grid>
                        <TextBlock Text="Recent uploads" Style="{StaticResource FlingTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearButton" Content="Clear list" HorizontalAlignment="Right"
                                Style="{StaticResource FlingQuietButtonStyle}" Click="ClearButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                               Text="Nothing uploaded yet. Files you fling show up here."
                               Style="{StaticResource FlingCaptionTextStyle}"/>
                    <StackPanel x:Name="Rows" Spacing="{StaticResource FlingSpace2}"/>
                </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:FlingToast x:Name="Toast"/>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fling.FlingToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Visibility="Collapsed">

    <Border x:Name="Card" Background="{ThemeResource FlingSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource FlingLineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource FlingRadiusMd}" Padding="{StaticResource FlingCardPadding}"
            Margin="{StaticResource FlingWindowPadding}" Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow/>
        </Border.Shadow>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Tones">
                <VisualState x:Name="Neutral"/>
                <VisualState x:Name="DoneTone">
                    <VisualState.Setters>
                        <Setter Target="ToneGlyph.Glyph" Value="&#xE73E;"/>
                        <Setter Target="ToneGlyph.Foreground" Value="{ThemeResource FlingDoneBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AlertTone">
                    <VisualState.Setters>
                        <Setter Target="ToneGlyph.Glyph" Value="&#xE7BA;"/>
                        <Setter Target="ToneGlyph.Foreground" Value="{ThemeResource FlingInkBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FlingSpace2}">
            <FontIcon x:Name="ToneGlyph" Glyph="&#xE8A5;" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource FlingInkMutedBrush}"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource FlingBodyTextStyle}"
                       VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
            <Button Style="{StaticResource FlingQuietSmallButtonStyle}" Click="Dismiss_Click"
                    VerticalAlignment="Center" AutomationProperties.Name="Dismiss">
                <FontIcon Glyph="&#xE711;" FontSize="10"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>

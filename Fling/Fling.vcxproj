  <!-- Copy vcpkg runtime DLLs (AWS SDK, zlib, etc.) next to Fling.exe so it can launch. -->
  <Target Name="_FlingCopyVcpkgRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_VcpkgBinDir Condition="'$(Configuration)' == 'Debug'">C:\dev\vcpkg\installed\x64-windows\debug\bin</_VcpkgBinDir>
      <_VcpkgBinDir Condition="'$(Configuration)' != 'Debug'">C:\dev\vcpkg\installed\x64-windows\bin</_VcpkgBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_VcpkgDlls Include="$(_VcpkgBinDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_VcpkgDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Hook XAML MarkupCompilePass1/2 into the native C++ build pipeline.
       The WindowsAppSDK Markup Compiler targets chain them off PrepareResources,
       which is part of the managed build, not the native one. -->
  <Target Name="_FlingRunXamlMarkupCompile"
          BeforeTargets="ClCompile"
          DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2"
          Condition="'@(Page)' != '' Or '@(ApplicationDefinition)' != ''" />
</Project>

  <!-- WebView2's winmd reference implies lib\Microsoft.Web.WebView2.Core.dll, which doesn't exist;
       the real x64 binary comes from runtimes\win-x64\native_uap. Without this, packaging fails with APPX1101. -->
  <Target Name="_FlingDropPhantomWebView2Payload" BeforeTargets="_ComputeAppxPackagePayload">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="'%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.Core.dll' And !Exists('%(FullPath)')" />
    </ItemGroup>
  </Target>

  <!-- vcpkg's app-local step only reports its DLLs (via ReferenceCopyLocalPaths) when the linker runs, so a
       no-op rebuild would package without them. Its copied-files log survives, so package from that instead. -->
  <Target Name="_FlingPackageVcpkgDlls" BeforeTargets="_ComputeAppxPackagePayload" Condition="Exists('$(IntDir)vcpkg.applocal.log')">
    <ReadLinesFromFile File="$(IntDir)vcpkg.applocal.log">
      <Output TaskParameter="Lines" ItemName="_FlingVcpkgDll" />
    </ReadLinesFromFile>
    <ItemGroup>
      <PackagingOutputs Remove="@(_FlingVcpkgDll)" />
      <PackagingOutputs Include="@(_FlingVcpkgDll)" Condition="Exists('%(FullPath)')">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
        <OutputGroup>CopyLocalFilesOutputGroup</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
      </PackagingOutputs>
    </ItemGroup>
  </Target>


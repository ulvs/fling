    <UseWinUI>true</UseWinUI>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <!-- Tell the XAML markup compiler this is a C++/WinRT project.
         Without this it defaults to $(Language) = "C++" and emits App.xaml.g.h
         code that bypasses App_base, making make<implementation::App>() return
         Microsoft::UI::Xaml::Application instead of Fling::App. -->
    <XamlLanguage>CppWinRT</XamlLanguage>
    <!-- Pin XAML codegen output to an absolute path.
         Without this, MarkupCompilePass writes .xaml.g.h to one location (relative
         to ProjectDir) while CopyGeneratedXaml resolves the same relative path
         against the MSBuild invocation CWD, ending up at a different spot. -->
    <XamlGeneratedOutputPath>$(ProjectDir)$(IntDir)</XamlGeneratedOutputPath>
  </PropertyGroup>


{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fling",
  "version": "1.0.0",
  "description": "Windows file-sharing tool with S3 integration",
  "builtin-baseline": "c27eeddba73f608f10605d80bc0144c1166f8fb7",
  "dependencies": [
    {
      "name": "aws-sdk-cpp",
      "features": [
        "s3",
        "transfer"
      ],
      "default-features": false
    },
    "nlohmann-json",
    "gtest",
    {
      "name": "minizip-ng",
      "default-features": false,
      "features": [
        "zlib"
      ]
    }
  ]
}
